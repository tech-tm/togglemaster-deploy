# ----------------------------------------------------------------------
# .gitignore do togglemaster-deploy
#
# Este repo e GitOps puro: so manifests Kubernetes, workflows e docs.
# Nao deveria ter artefatos de build, state de ferramentas ou segredos.
# ----------------------------------------------------------------------

# --- Segredos (NUNCA versionar) ---
.env
.env.*
*.pem
*.key
credentials
secrets.yaml
secret.yaml

# --- Artefatos de validacao / debug local ---
# Ex: 'helm template > render.yaml', 'logs/' de testes locais, etc.
*-render.yaml
*-render.yml
*-err.log
*.log
/tmp/
tmp/

# --- Kubectl / Kubeconfig ---
kubeconfig
*.kubeconfig
.kube/

# --- Helm (se alguem rodar helm localmente para testar charts) ---
charts/
*.tgz
.helm/

# --- Terraform ---
# A pasta 'terraform/' da camada Datadog (gerenciada por este repo) e
# incluida; artefatos locais e tfvars de override pessoal sao ignorados.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl

# Ignora qualquer *.tfvars por default (podem conter secrets de override)...
*.tfvars

# ...mas permite o tfvars principal da camada Datadog, que NAO contem
# segredos (todos os valores sensiveis vem do SSM via providers.tf).
!terraform/terraform.tfvars

# Overrides locais (uso pessoal, nao versionar)
*.auto.tfvars
*.local.tfvars

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- SO ---
.DS_Store
Thumbs.db
